<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Jeu : Attrapeur</title>
<style>
  :root{--bg:#0b1220;--panier:#ffb86b;--obj:#8be9fd;--text:#e6edf3}
  html,body{height:100%;margin:0;font-family:Arial,Helvetica,sans-serif;background:radial-gradient(circle at 10% 10%, #112, var(--bg));color:var(--text)}
  #gameWrap{width:100%;max-width:640px;margin:24px auto;padding:12px;background:linear-gradient(180deg, rgba(255,255,255,0.03), transparent);border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.5)}
  header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
  h1{font-size:1rem;margin:0}
  .hud{font-size:0.95rem}
  canvas{display:block;width:100%;background:linear-gradient(#08101a,#07101a);border-radius:6px;cursor:pointer}
  .controls{display:flex;gap:8px;justify-content:center;margin-top:8px}
  button{background:#222;color:var(--text);border:1px solid rgba(255,255,255,0.04);padding:8px 12px;border-radius:6px;cursor:pointer}
  button:active{transform:translateY(1px)}
  .small{font-size:.9rem;padding:6px 8px}
</style>
</head>
<body>
<div id="gameWrap">
  <header>
    <h1>Attrapeur</h1>
    <div class="hud">Score: <span id="score">0</span> — Vies: <span id="lives">3</span></div>
  </header>

  <canvas id="game" width="640" height="360" title="Cliquez ou utilisez ← → pour bouger"></canvas>

  <div class="controls">
    <button id="start" class="small">Démarrer</button>
    <button id="pause" class="small">Pause</button>
    <button id="reset" class="small">Réinitialiser</button>
  </div>
</div>

<script>
/* Simple "catch" game */
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const livesEl = document.getElementById('lives');
const startBtn = document.getElementById('start');
const pauseBtn = document.getElementById('pause');
const resetBtn = document.getElementById('reset');

let W = canvas.width, H = canvas.height;
let running = false, paused = false;
let score = 0, lives = 3, level = 1;
let lastSpawn = 0, spawnInterval = 1200;
let objects = [];

const basket = { x: W/2 - 40, y: H - 36, w: 80, h: 18, speed: 6 };

function resizeCanvas(){
  // keep internal resolution fixed; CSS scales it in layout — optional
}
window.addEventListener('resize', resizeCanvas);

function spawnObject(){
  const size = 14 + Math.random()*16;
  const x = Math.random()*(W - size - 10) + 5;
  const speed = 1.2 + Math.random()*1.6 + level*0.15;
  const kind = Math.random() < 0.8 ? 'good' : 'bad';
  objects.push({ x, y: -size, w: size, h: size, speed, kind });
}

function update(dt){
  if(paused) return;
  lastSpawn += dt;
  if(lastSpawn > spawnInterval){
    lastSpawn = 0;
    spawnObject();
    if(Math.random() < 0.08) spawnInterval = Math.max(450, spawnInterval * 0.95);
  }

  // move objects
  for(let i = objects.length-1; i >= 0; i--){
    const o = objects[i];
    o.y += o.speed * dt * 0.06;
    // collision with basket
    if(o.y + o.h >= basket.y && o.x + o.w > basket.x && o.x < basket.x + basket.w){
      if(o.kind === 'good'){ score += Math.round(10 + o.w); }
      else { lives -= 1; }
      objects.splice(i,1);
      continue;
    }
    // missed
    if(o.y > H + 20){ objects.splice(i,1); if(o.kind === 'good'){ lives -= 1; } }
  }

  // level up by score
  level = 1 + Math.floor(score / 200);

  // update HUD
  scoreEl.textContent = score;
  livesEl.textContent = lives;

  if(lives <= 0){ running = false; paused = true; showGameOver(); }
}

function showGameOver(){
  // simple overlay
  ctx.fillStyle = 'rgba(2,6,12,0.6)';
  ctx.fillRect(0,0,W,H);
  ctx.fillStyle = '#fff';
  ctx.font = '28px Arial';
  ctx.textAlign = 'center';
  ctx.fillText('Game Over', W/2, H/2 - 10);
  ctx.font = '16px Arial';
  ctx.fillText('Cliquez Démarrer pour rejouer', W/2, H/2 + 20);
}

function draw(){
  // clear
  ctx.clearRect(0,0,W,H);

  // draw background stars
  ctx.fillStyle = '#071724';
  ctx.fillRect(0,0,W,H);

  // draw objects
  for(const o of objects){
    ctx.fillStyle = o.kind === 'good' ? '#8be9fd' : '#ff6b6b';
    ctx.beginPath();
    ctx.roundRect ? ctx.roundRect(o.x,o.y,o.w,o.h,4) : roundRect(ctx,o.x,o.y,o.w,o.h,4);
    ctx.fill();
  }

  // draw basket
  ctx.fillStyle = '#ffb86b';
  ctx.beginPath();
  ctx.fillRect(basket.x, basket.y, basket.w, basket.h);
  // rim
  ctx.fillStyle = '#d98f4f';
  ctx.fillRect(basket.x, basket.y-6, basket.w, 6);

  // score small text
  ctx.fillStyle = 'rgba(255,255,255,0.9)';
  ctx.font = '13px Arial';
  ctx.textAlign = 'left';
  ctx.fillText('Niveau ' + level, 10, 18);
}

function roundRect(ctx,x,y,w,h,r){
  const min = Math.min(w,h)/2;
  if(r>min) r=min;
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

let lastTime = 0;
function loop(ts){
  if(!running){ if(paused) return; } 
  const dt = ts - lastTime || 16;
  lastTime = ts;
  update(dt);
  draw();
  if(running || !paused) requestAnimationFrame(loop);
}

canvas.addEventListener('mousemove', (e)=>{
  const rect = canvas.getBoundingClientRect();
  const mx = (e.clientX - rect.left) * (canvas.width / rect.width);
  basket.x = Math.min(Math.max(0, mx - basket.w/2), W - basket.w);
});

document.addEventListener('keydown', (e)=>{
  if(e.key === 'ArrowLeft'){ basket.x = Math.max(0, basket.x - basket.speed*8); }
  if(e.key === 'ArrowRight'){ basket.x = Math.min(W - basket.w, basket.x + basket.speed*8); }
  if(e.key === 'p'){ togglePause(); }
});

canvas.addEventListener('click', ()=>{
  // small boost to move towards click
  const rect = canvas.getBoundingClientRect();
  const mx = (event.clientX - rect.left) * (canvas.width / rect.width);
  if(mx < basket.x) basket.x = Math.max(0, basket.x - 40);
  else basket.x = Math.min(W - basket.w, basket.x + 40);
});

startBtn.addEventListener('click', startGame);
pauseBtn.addEventListener('click', togglePause);
resetBtn.addEventListener('click', resetGame);

function startGame(){
  if(running) return;
  running = true; paused = false;
  if(lives <= 0) { score = 0; lives = 3; objects = []; spawnInterval = 1200; }
  lastTime = performance.now();
  requestAnimationFrame(loop);
}

function togglePause(){
  paused = !paused;
  if(!paused && running) { lastTime = performance.now(); requestAnimationFrame(loop); }
}

function resetGame(){
  running = false; paused = true;
  score = 0; lives = 3; level = 1; objects = []; spawnInterval = 1200;
  scoreEl.textContent = score; livesEl.textContent = lives;
  ctx.clearRect(0,0,W,H);
  draw();
}

// initial draw
draw();
</script>
